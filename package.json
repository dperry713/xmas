{
  "name": "advent-piazza-3d",
  "version": "1.0.0",
  "description": "24-Day Interactive 3D European Piazza Advent Calendar Experience built with Three.js and TypeScript",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "compress-textures": "node scripts/compress-textures.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
